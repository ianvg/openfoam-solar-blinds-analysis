//Reminder that this number parameter needs to correspond with the run_solver.sh parameter
numberOfSubdomains 4;

method          scotch;

/* 
For the simple method of decomposition

simpleCoeffs
{
    n               ( 4 2 1 );
    delta           0.001;
}
*/

/*
For the hierarchical method of decomposition
hierarchicalCoeffs
{
    n               ( 2 2 1 );
    delta           0.001;
    order           xyz;
}
