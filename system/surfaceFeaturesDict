FoamFile
{
    format      ascii;
    class       dictionary;
    object      surfaceFeaturesDict;
}

surfaces ("Window_1.stl");

// Feature edges are extracted where adjacent triangle normals differ enough.
// This follows the reference case style, but targets the local STL.
includedAngle 150;

subsetFeatures
{
    nonManifoldEdges no;
    openEdges        yes;
}

writeObj yes;

