FoamFile
{
    format      ascii;
    class       volScalarField;
    location	"0";
    object      epsilon;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //


  dimensions      [0 2 -3 0 0 0 0];

  internalField   uniform 0.0135;

  boundaryField
  {
      inlet
      {
          type            fixedValue;
          value           uniform 0.0135;
      }

      outlet
      {
          type            zeroGradient;
      }

//Ensure that the parameters below are in line with the blockMeshDict parameters.
      minY
      {
        type		slip;
        //type            symmetryPlane;
      }

      maxY
      {
        type		slip;
        //type            symmetryPlane;
      }

      minZ
      {
        type		slip;
        //type            symmetryPlane;
      }

      maxZ
      {
        type		slip;
        //type            symmetryPlane;
      }

      window_wall
      {
          type            epsilonWallFunction;
          value           uniform 0.0135;
      }
  }

  // ************************************************************************* //

