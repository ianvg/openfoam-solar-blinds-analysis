FoamFile
{
    format      ascii;
    class       dictionary;
    object      sampleDict1;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

// This sample dictionary computes the area average differential pressure
// between in the inlet patch and the outlet patch.

type            fieldValueDelta;
libs            ("libfieldFunctionObjects.so");

log             true;
writeControl    timeStep;
writeInterval   1;

// Reports areaAverage(pPa on inlet) - areaAverage(pPa on outlet).
// pPa must be generated first, e.g. with:
// foamPostProcess -funcs '(pPa inletOutletPressureDrop)'
operation       subtract;

region1
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    writeFields     false;
    patch           inlet;
    operation       areaAverage;
    fields          (pPa);
}

region2
{
    type            surfaceFieldValue;
    libs            ("libfieldFunctionObjects.so");
    writeFields     false;
    patch           outlet;
    operation       areaAverage;
    fields          (pPa);
}

