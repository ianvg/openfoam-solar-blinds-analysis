	phi		phi;
	inletValue	uniform (1 0 0);
	value		uniform (1 0 0);
	*/
    }

//Ensure that the conditions below are in line with the blockMeshDict parameters.
    minY
    {
		type		cyclic;
		//type		slip;
		//type		symmetryPlane;
    }

    maxY
    {
		type		cyclic;
		//type		slip;
		//type		symmetryPlane;
    }

    minZ
    {
		type		cyclic;
		//type		slip;
		//type		symmetryPlane;
    }

    maxZ
    {
		type		cyclic;
		//type		slip;
		//type		symmetryPlane;
    }

    solidSurfaces
    {
        type            noSlip;
    }
}

