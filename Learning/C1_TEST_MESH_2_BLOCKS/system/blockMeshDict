convertToMeters 1;


// Block 1
xmin -10; //inlet refer to COST 732 / Franke et al. best-practice guidance for urban CFD
xmax  0.05; //outlet
ymin -2.5;
ymax  2.5;
zmin -2.5;
zmax  2.5;

// Block 2
xmin2 0.05; //inlet refer to COST 732 / Franke et al. best-practice guidance for urban CFD
xmax2 30; //outlet
ymin2 -2.5;
ymax2  2.5;
zmin2 -2.5;
zmax2  2.5;



//xcells 20;
//ycells 20;
//zcells 20;

// Block 1 number of cells

lx #calc "$xmax - $xmin";
dx 0.5; //Originally 0.5
//dx 1;
xcells #calc "abs(($lx)/($dx))";

ly #calc "$ymax - $ymin";
dy 0.5; //Originally 0.5
//dy 1;
ycells #calc "abs(($ly)/($dy))";

lz #calc "$zmax - $zmin";
//dz 20;	//BL OK at bottom - Better mesh at corners at the bottom
dz 0.5;	//Originally 0.5	//BL colapses at bottom - Mesh at the bottom corners is uglier
//dz 1;
zcells #calc "abs(($lz)/($dz))";


// Block 2 number of cells

lx2 #calc "$xmax2 - $xmin2";
dx2 0.5; //Originally 0.5
//dx 1;
xcells2 #calc "abs(($lx2)/($dx2))";

ly2 #calc "$ymax2 - $ymin2";
dy2 0.5; //Originally 0.5
//dy 1;
ycells2 #calc "abs(($ly2)/($dy2))";

lz2 #calc "$zmax2 - $zmin2";
//dz 20;	//BL OK at bottom - Better mesh at corners at the bottom
dz2 0.5;	//Originally 0.5	//BL colapses at bottom - Mesh at the bottom corners is uglier
//dz 1;
zcells2 #calc "abs(($lz2)/($dz2))";


