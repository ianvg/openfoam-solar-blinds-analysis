// Computes the volume average differential pressure between the outdoor and
// indoor cellZones using pGaugePa.

type            fieldValueDelta;
libs            ("libfieldFunctionObjects.so");

log             true;
writeControl    writeTime;

// Reports volAverage(pGaugePa in domainOutside)
//       - volAverage(pGaugePa in domainInside).
operation       subtract;

region1
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");

    writeFields     false;
    cellZone        domainOutside;
    operation       volAverage;
    fields          (pGaugePa);
}

region2
{
    type            volFieldValue;
    libs            ("libfieldFunctionObjects.so");

    writeFields     false;
    cellZone        domainInside;
    operation       volAverage;
    fields          (pGaugePa);
}

