FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

solver     incompressibleFluid;

startFrom       startTime;
startTime       0;

//stopAt	writeNow; //Use this to gracefully end and save the simulation
stopAt          endTime;

endTime         60;

deltaT          0.5; //1 is a little coarse, so changing it to 0.05 

writeControl    timeStep;
writeInterval   1;

purgeWrite      0;

writeFormat     ascii;
writePrecision  6;
writeCompression off;

timeFormat      general;
timePrecision   6;

runTimeModifiable true;

// ************************************************************************* //

functions
{

///////////////////////////////////////////////////////////////////////////
/// Function
///////////////////////////////////////////////////////////////////////////

// External function object below calls three calculations:
// pGaugePa
// pAtm
// pPa

#include "externalFunctionObject"

windowOpeningFlowRateCutPlane
{
	type            surfaceFieldValue;
	libs            ("libfieldFunctionObjects.so");

	log             true;
	writeControl    timeStep;
	writeInterval   1;
	
	writeFields	true; // I'm interested in this value
	surfaceFormat	vtk;

	sampledSurface
	{
		type	cutPlane;
		planeType	pointAndNormal;
		point	(0 0 0);
		normal	(1 0 0);
		interpolate	true;
	}

	operation       areaNormalIntegrate;

	fields          (U);
}


windowOpeningFlowRate
{
	type            surfaceFieldValue;
	libs            ("libfieldFunctionObjects.so");

	log             true;
	writeControl    timeStep;
	writeInterval   1;
	
	writeFields	true; // I'm interested in this value
	surfaceFormat	vtk;

	sampledSurface
	{
		type        triSurface;
		surface     "samplingSTL.stl";
		source      cells;
		interpolate true;
	}

	operation       areaNormalIntegrate;

	fields          (U);
}

