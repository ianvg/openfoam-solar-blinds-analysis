FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      functionObject;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
  
  windowOpening_flowRate
  {
      type            surfaceFieldValue;
      libs            ("libfieldFunctionObjects.so");
      enabled         true;

      writeControl    timeStep;
      writeInterval   1;

      log             true;
      writeFields     false;

      regionType      sampledSurface;
      name            windowOpening;

      sampledSurface
      {
          type        triSurfaceMesh;
          surface     "windowOpening.stl";
          source      cells;
          interpolate true;
      }

      operation       areaNormalIntegrate;

      fields
      (
          U
      );
  }
