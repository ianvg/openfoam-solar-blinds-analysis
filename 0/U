FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (5 0 0);

boundaryField
{
    inlet
    {
/*
        type             uniformFixedValue;
	uniformValue     table
	(
    		(0   (1 0 0))
    		(20  (2 0 0))
   		(40  (1 0 0))
	); 
*/

        type            fixedValue;
        value           uniform (5 0 0);
    }

    outlet
    {
        type            zeroGradient;
	
	/*
	type		inletOutlet;
	phi		phi;
	inletValue	uniform (1 0 0);
	value		uniform (1 0 0);
	*/
    }

//Ensure that the conditions below are in line with the blockMeshDict parameters.
    minY
    {
        //type            slip;
        type            symmetryPlane;
    }

    maxY
    {
        //type            slip;
        type            symmetryPlane;
    }

    minZ
    {
        //type            slip;
        type            symmetryPlane;
    }

    maxZ
    {
        //type            slip;
        type            symmetryPlane;
    }

    window_wall
    {
        type            noSlip;
    }
}

