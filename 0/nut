FoamFile
{
    format      ascii;
    class       volScalarField;
    location	"0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//nut is ratio between omega and k

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 1e-5;

boundaryField
{
    inlet
    {
        type            calculated;
        value           uniform 1e-5;
    }
    outlet
    {
        type            calculated;
        value		uniform 1e-5;
    }
    
 //Ensure that the parameters below are in line with the blockMeshDict parameters
    minY
    {
        type		slip;
        //type            symmetryPlane;
    }
    maxY
    {
        type		slip;
        //type            symmetryPlane;
    }
    minZ
    {
        type		slip;
        //type            symmetryPlane;
    }
    maxZ
    {
        type		slip;
        //type            symmetryPlane;
    }
    window_wall
    {
        type            nutkWallFunction;
        value		uniform 0;
    }
}

