FoamFile
{
    format      ascii;
    class       volScalarField;
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

//The value for k is a function of velocity, and turbulence intensity

dimensions      [0 2 -2 0 0 0 0];

//internalField   uniform 0.00015;
internalField   uniform 0.09375;

boundaryField
{
    inlet
    {
        //type            inletOutlet; // inletOutlet combination uses inletValue I think
        //inletValue	uniform 0.09375;
        
        type		fixedValue;
        value           uniform 0.09375;
    }
    outlet
    {
        type            zeroGradient;
    }
    minY
    {
        type            symmetryPlane;
    }
    maxY
    {
        type            symmetryPlane;
    }
    minZ
    {
        type            symmetryPlane;
    }
    maxZ
    {
        type            symmetryPlane;
    }
    window_wall
    {
        type            kqRWallFunction;
        value		uniform 0.09375;
    }
}

