FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    inlet
    {
        type            zeroGradient;
    }

    outlet
    {
        type            fixedValue;
        value           uniform 0;
    }

//Ensure that the parameters below are in line with the blockMeshDict parameters.
    minY
    {
        type		slip;
        //type            symmetryPlane;
    }

    maxY
    {
        type		slip;
        //type            symmetryPlane;
    }

    minZ
    {
        type		slip;
        //type            symmetryPlane;
    }

    maxZ
    {
        type		slip;
        //type            symmetryPlane;
    }

    window_wall
    {
        type		slip;
        //type            symmetryPlane;
    }
}

