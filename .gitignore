# This file contains all the files, file types and directories to ignore when pulling and pushing to the GitHub repository.
# OpenFOAM generated time directories
[1-9]*
0.* 
*.OpenFOAM

# Mesh and processor outputs
processor*
dynamicCode/
constant/polyMesh
constant/extendedFeatureEdgeMesh/
constant/triSurface/*.eMesh
!constant/polyMesh/blockMeshDict
0/cellLevel
0/pointLevel
0/nSurfaceLayers
0/thickness
0/thicknessFraction

# Logs
log.*
*.log

# Post-processing
postProcessing/

# ParaView and visualization
*.foam
*.OpenFOAM

# Temporary/editor files
*~
*.swp
.DS_Store
Thumbs.db
*:Zone.Identifier
