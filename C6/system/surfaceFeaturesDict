FoamFile
{
    format      ascii;
    class       dictionary;
    object      surfaceFeaturesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

interiorSurfacesWindowOnly
{
	surfaces ("interiorSurfacesWindowOnly.stl");

	includedAngle 150;
	
	subsetFeatures
	{
		insideBox        (-1 0.79 0.54) (2 2.83 2.26);

		nonManifoldEdges no;
		openEdges        yes;
	}

	writeObj	yes;
}

interiorSurfacesAll
{
	surfaces ("interiorSurfaces_60deg_75pct.stl");

	includedAngle 150;

	subsetFeatures
	{
	    nonManifoldEdges no;
	    openEdges        yes;
	}


	writeObj yes;
}

